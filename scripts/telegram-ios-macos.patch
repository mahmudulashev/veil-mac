--- /dev/null
+++ b/submodules/TelegramVoip/Sources/BroadcastPartSlice.swift
@@ -0,0 +1,30 @@
+#if os(macOS)
+import Foundation
+import TgVoipWebrtc
+import TelegramCore
+import HLSPlayback
+
+public func broadcastPartSlice(_ data: Data) -> Data? {
+    var info = BroadcastPartHeaderInfo()
+    let parsed = data.withUnsafeBytes { raw -> Bool in
+        guard let base = raw.bindMemory(to: UInt8.self).baseAddress else {
+            return false
+        }
+        return BroadcastPartHeaderParse(base, raw.count, &info)
+    }
+    guard parsed, info.sliceOffset <= data.count, info.sliceOffset + info.sliceSize <= data.count else {
+        return nil
+    }
+    let start = data.startIndex + info.sliceOffset
+    return data.subdata(in: start ..< start + info.sliceSize)
+}
+
+public func broadcastNetworkClass(_ networkType: NetworkType) -> HLSNetworkClass {
+    switch networkType {
+    case .none:
+        return HLSNetworkClass("none")
+    case .wifi:
+        return HLSNetworkClass("wifi")
+    }
+}
+#endif
diff --git a/submodules/TelegramVoip/Sources/GroupCallBroadcastFetcher.swift b/submodules/TelegramVoip/Sources/GroupCallBroadcastFetcher.swift
new file mode 100644
index 00000000..01220652
--- /dev/null
+++ b/submodules/TelegramVoip/Sources/GroupCallBroadcastFetcher.swift
@@ -0,0 +1,95 @@
+#if os(macOS)
+import Foundation
+import SwiftSignalKit
+import TgVoipWebrtc
+import TelegramCore
+import BroadcastPlayback
+
+public final class GroupCallBroadcastFetcher {
+    private let source: BroadcastPartSource
+
+    init(source: BroadcastPartSource) {
+        self.source = source
+    }
+
+    public convenience init(queue: Queue, audioStreamData: OngoingGroupCallContext.AudioStreamData) {
+        self.init(source: NetworkBroadcastPartSource(queue: queue, engine: audioStreamData.engine, callId: audioStreamData.callId, accessHash: audioStreamData.accessHash, isExternalStream: audioStreamData.isExternalStream))
+    }
+
+    public func edge(completion: @escaping (BroadcastEdgeOutcome) -> Void) -> Disposable {
+        return self.source.requestTime(completion: { timestampMs in
+            if timestampMs > 0 {
+                completion(.edge(reportedMs: timestampMs))
+            } else {
+                completion(.failed)
+            }
+        })
+    }
+
+    public func load(_ request: BroadcastPartRequest, completion: @escaping (BroadcastPartOutcome, Data?) -> Void) -> Disposable {
+        let subject: BroadcastPartSubject
+        switch request.kind {
+        case .audio:
+            subject = .audio
+        case let .video(channelId, quality):
+            subject = .video(channelId: channelId, quality: GroupCallBroadcastFetcher.quality(quality))
+        case let .unified(quality):
+            subject = .video(channelId: 1, quality: GroupCallBroadcastFetcher.quality(quality))
+        }
+        return self.source.requestPart(timestampMilliseconds: request.timestampMs, durationMilliseconds: BroadcastLivePosition.partDurationMs, subject: subject, completion: { part in
+            switch part.status {
+            case .success:
+                let data = part.oggData
+                completion(.data(bytes: Int64(data.count), responseTimestamp: part.responseTimestamp, info: GroupCallBroadcastFetcher.info(for: request, data: data)), data)
+            case .notReady:
+                completion(.notReady, nil)
+            case .resyncNeeded:
+                completion(.resyncNeeded(responseTimestamp: part.responseTimestamp), nil)
+            @unknown default:
+                completion(.notReady, nil)
+            }
+        }, rejoinNeeded: {
+            completion(.rejoinNeeded, nil)
+        })
+    }
+
+    private static func quality(_ quality: BroadcastQuality) -> OngoingGroupCallContext.VideoChannel.Quality {
+        switch quality {
+        case .thumbnail:
+            return .thumbnail
+        case .medium:
+            return .medium
+        case .full:
+            return .full
+        }
+    }
+
+    public static func info(for request: BroadcastPartRequest, data: Data) -> BroadcastPartInfo {
+        guard case .audio = request.kind, !data.isEmpty else {
+            return BroadcastPartInfo()
+        }
+        var info = BroadcastListenerAudioInfo()
+        let parsed = data.withUnsafeBytes { raw -> Bool in
+            guard let base = raw.bindMemory(to: UInt8.self).baseAddress else {
+                return false
+            }
+            return BroadcastListenerAudioReadInfo(base, raw.count, &info)
+        }
+        guard parsed else {
+            return BroadcastPartInfo()
+        }
+        var channels: [String: Int32] = [:]
+        withUnsafeBytes(of: &info.endpoints) { raw in
+            let endpoints = raw.bindMemory(to: BroadcastListenerAudioEndpoint.self)
+            for index in 0 ..< min(info.endpointCount, endpoints.count) {
+                var endpoint = endpoints[index]
+                let name = withUnsafeBytes(of: &endpoint.endpointId) { bytes -> String in
+                    return String(cString: bytes.bindMemory(to: CChar.self).baseAddress!)
+                }
+                channels[name] = endpoint.channelId
+            }
+        }
+        return BroadcastPartInfo(videoChannels: channels, audioDurationMs: Int(info.durationMs))
+    }
+}
+#endif
diff --git a/submodules/TelegramVoip/Sources/GroupCallBroadcastLevels.swift b/submodules/TelegramVoip/Sources/GroupCallBroadcastLevels.swift
new file mode 100644
index 00000000..0080b226
--- /dev/null
+++ b/submodules/TelegramVoip/Sources/GroupCallBroadcastLevels.swift
@@ -0,0 +1,32 @@
+#if os(macOS)
+import Foundation
+import BroadcastPlayback
+
+public struct GroupCallBroadcastLevels {
+    private var pending: [UInt32: (level: Float, voice: Bool)] = [:]
+
+    public init() {
+    }
+
+    public mutating func add(_ samples: [BroadcastAudioLevelSample]) {
+        for sample in samples {
+            if let current = self.pending[sample.ssrc] {
+                self.pending[sample.ssrc] = (max(current.level, sample.level), current.voice || sample.voice)
+            } else {
+                self.pending[sample.ssrc] = (sample.level, sample.voice)
+            }
+        }
+    }
+
+    public mutating func merged(into engineLevels: [(OngoingGroupCallContext.AudioLevelKey, Float, Bool)]) -> [(OngoingGroupCallContext.AudioLevelKey, Float, Bool)] {
+        var result = engineLevels
+        for ssrc in self.pending.keys.sorted() {
+            if let value = self.pending[ssrc] {
+                result.append((.source(ssrc), value.level, value.voice))
+            }
+        }
+        self.pending.removeAll()
+        return result
+    }
+}
+#endif
diff --git a/submodules/TelegramVoip/Sources/GroupCallBroadcastPlatform.swift b/submodules/TelegramVoip/Sources/GroupCallBroadcastPlatform.swift
new file mode 100644
index 00000000..f71b7708
--- /dev/null
+++ b/submodules/TelegramVoip/Sources/GroupCallBroadcastPlatform.swift
@@ -0,0 +1,190 @@
+#if os(macOS)
+import Foundation
+import QuartzCore
+import SwiftSignalKit
+import TgVoipWebrtc
+import BroadcastPlayback
+
+public final class GroupCallBroadcastPlatform: BroadcastListenerPlatform {
+    private final class Token: BroadcastCancellable {
+        var cancelled = false
+        var disposable: Disposable?
+
+        func cancel() {
+            self.cancelled = true
+            self.disposable?.dispose()
+            self.disposable = nil
+        }
+    }
+
+    private let queue: Queue
+    private let audioCore: OpaquePointer
+    private let fetcher: () -> GroupCallBroadcastFetcher?
+    private let videoOutput: GroupCallBroadcastVideoOutput
+    private let rejoinNeeded: () -> Void
+    private let decodeQueue: DispatchQueue
+    private let enqueue: (BroadcastListenerAudioPartRef, Int64) -> Bool
+    private var isClosed = false
+
+    public init(queue: Queue, audioCore: OpaquePointer, fetcher: @escaping () -> GroupCallBroadcastFetcher?, videoOutput: GroupCallBroadcastVideoOutput, rejoinNeeded: @escaping () -> Void, decodeQueue: DispatchQueue = DispatchQueue(label: "GroupCallBroadcast.audio-decode"), enqueue: ((BroadcastListenerAudioPartRef, Int64) -> Bool)? = nil) {
+        self.queue = queue
+        self.audioCore = audioCore
+        self.fetcher = fetcher
+        self.videoOutput = videoOutput
+        self.rejoinNeeded = rejoinNeeded
+        self.decodeQueue = decodeQueue
+        if let enqueue {
+            self.enqueue = enqueue
+        } else {
+            self.enqueue = { part, timestampMs in
+                return BroadcastListenerAudioPartEnqueue(part, audioCore, timestampMs)
+            }
+        }
+    }
+
+    public func close() {
+        self.isClosed = true
+    }
+
+    public var now: Double {
+        return BroadcastAudioCoreNow(self.audioCore)
+    }
+
+    public func schedule(after delay: Double, _ action: @escaping () -> Void) -> BroadcastCancellable {
+        let token = Token()
+        self.queue.after(max(0.0, delay), { [weak self] in
+            guard let self, !self.isClosed, !token.cancelled else {
+                return
+            }
+            action()
+        })
+        return token
+    }
+
+    private func onQueue(_ token: Token, _ f: @escaping () -> Void) {
+        let deliver: () -> Void = { [weak self] in
+            guard let self, !self.isClosed, !token.cancelled else {
+                return
+            }
+            f()
+        }
+        if self.queue.isCurrent() {
+            deliver()
+        } else {
+            self.queue.async(deliver)
+        }
+    }
+
+    public func requestLiveEdge(completion: @escaping (BroadcastEdgeOutcome) -> Void) -> BroadcastCancellable {
+        let token = Token()
+        guard let fetcher = self.fetcher() else {
+            completion(.failed)
+            return token
+        }
+        token.disposable = fetcher.edge(completion: { [weak self] outcome in
+            self?.onQueue(token, {
+                completion(outcome)
+            })
+        })
+        return token
+    }
+
+    public func loadPart(_ request: BroadcastPartRequest, completion: @escaping (BroadcastPartOutcome, Data?) -> Void) -> BroadcastCancellable {
+        let token = Token()
+        guard let fetcher = self.fetcher() else {
+            completion(.notReady, nil)
+            return token
+        }
+        token.disposable = fetcher.load(request, completion: { [weak self] outcome, data in
+            self?.onQueue(token, {
+                completion(outcome, data)
+            })
+        })
+        return token
+    }
+
+    public func handOverAudio(segmentTimestampMs: Int64, data: Data, gate: BroadcastAudioHandover.Gate) {
+        let queue = self.queue
+        let enqueue = self.enqueue
+        self.decodeQueue.async { [weak self] in
+            let part = data.withUnsafeBytes { raw -> BroadcastListenerAudioPartRef? in
+                guard let base = raw.bindMemory(to: UInt8.self).baseAddress else {
+                    return nil
+                }
+                return BroadcastListenerAudioDecode(base, raw.count)
+            }
+            guard let part else {
+                return
+            }
+            queue.async {
+                if let self, !self.isClosed, !gate.isClosed {
+                    let _ = enqueue(part, segmentTimestampMs)
+                }
+                BroadcastListenerAudioPartRelease(part)
+            }
+        }
+    }
+
+    public func playAudio(segmentTimestampMs: Int64, at hostTime: Double, offsetMs: Int) {
+        if self.isClosed {
+            return
+        }
+        let _ = BroadcastAudioCorePlay(self.audioCore, segmentTimestampMs, hostTime, Int32(offsetMs))
+    }
+
+    public func setAudioActive(_ isActive: Bool) {
+        if self.isClosed {
+            return
+        }
+        BroadcastAudioCoreSetActive(self.audioCore, isActive)
+    }
+
+    public func setAudioVolume(ssrc: UInt32, volume: Float) {
+        if self.isClosed {
+            return
+        }
+        BroadcastAudioCoreSetVolume(self.audioCore, ssrc, volume)
+    }
+
+    public func resetAudio() {
+        if self.isClosed {
+            return
+        }
+        BroadcastAudioCoreReset(self.audioCore)
+    }
+
+    public func takeAudioLevels() -> [BroadcastAudioLevelSample] {
+        if self.isClosed {
+            return []
+        }
+        var levels = [BroadcastAudioLevel](repeating: BroadcastAudioLevel(), count: 64)
+        let count = BroadcastAudioCoreTakeLevels(self.audioCore, &levels, levels.count)
+        return levels.prefix(count).map { BroadcastAudioLevelSample(ssrc: $0.ssrc, level: $0.level, voice: $0.voice) }
+    }
+
+    public func deliverVideo(_ segment: BroadcastSegment, data: [BroadcastPartRequest: Data]) {
+        if self.isClosed {
+            return
+        }
+        self.videoOutput.deliver(segment, data: data)
+    }
+
+    public func playVideo(segmentTimestampMs: Int64, at hostTime: Double, offsetMs: Int) {
+        if self.isClosed {
+            return
+        }
+        self.videoOutput.play(segmentTimestampMs: segmentTimestampMs, hostTime: hostTime, offsetMs: offsetMs)
+    }
+
+    public func stopVideo() {
+        self.videoOutput.stop()
+    }
+
+    public func requestRejoin() {
+        if self.isClosed {
+            return
+        }
+        self.rejoinNeeded()
+    }
+}
+#endif
diff --git a/submodules/TelegramVoip/Sources/GroupCallBroadcastVideoOutput.swift b/submodules/TelegramVoip/Sources/GroupCallBroadcastVideoOutput.swift
new file mode 100644
index 00000000..314d5d50
--- /dev/null
+++ b/submodules/TelegramVoip/Sources/GroupCallBroadcastVideoOutput.swift
@@ -0,0 +1,188 @@
+#if os(macOS)
+import Foundation
+import QuartzCore
+import SwiftSignalKit
+import TgVoipWebrtc
+import BroadcastPlayback
+
+public final class GroupCallBroadcastVideoOutput {
+    private final class Endpoint {
+        let id: String
+        let queue: DispatchQueue
+        let decoder: BroadcastVideoDecoderRef
+        let frames: ValuePipe<OngoingGroupCallContext.VideoFrameData>
+        var parts: [Int64: BroadcastVideoPartRef] = [:]
+        var playhead: BroadcastPlayhead
+        var shown: (timestampMs: Int64, index: Int32)?
+        var timer: DispatchSourceTimer?
+        var lastDeliveredMs: Int64 = Int64.min
+
+        init(id: String, playhead: BroadcastPlayhead, frames: ValuePipe<OngoingGroupCallContext.VideoFrameData>) {
+            self.id = id
+            self.playhead = playhead
+            self.frames = frames
+            self.queue = DispatchQueue(label: "GroupCallBroadcastVideo.\(id)")
+            self.decoder = BroadcastVideoDecoderCreate(true)
+        }
+    }
+
+    private var endpoints: [String: Endpoint] = [:]
+    private var playhead = BroadcastPlayhead()
+    private let pipes = Atomic<[String: ValuePipe<OngoingGroupCallContext.VideoFrameData>]>(value: [:])
+
+    public init() {
+    }
+
+    var endpointIds: [String] {
+        return self.endpoints.keys.sorted()
+    }
+
+    public func video(endpointId: String) -> Signal<OngoingGroupCallContext.VideoFrameData, NoError> {
+        return self.pipe(endpointId).signal()
+    }
+
+    public func deliver(_ segment: BroadcastSegment, data: [BroadcastPartRequest: Data]) {
+        for (endpointId, request) in segment.video {
+            guard let bytes = data[request] else {
+                continue
+            }
+            let endpoint = self.endpoint(endpointId)
+            let timestampMs = segment.timestampMs
+            endpoint.lastDeliveredMs = max(endpoint.lastDeliveredMs, timestampMs)
+            endpoint.queue.async {
+                let part = bytes.withUnsafeBytes { raw -> BroadcastVideoPartRef? in
+                    guard let base = raw.bindMemory(to: UInt8.self).baseAddress else {
+                        return nil
+                    }
+                    return BroadcastVideoPartOpen(endpoint.decoder, base, raw.count)
+                }
+                if let previous = endpoint.parts[timestampMs] {
+                    BroadcastVideoPartRelease(previous)
+                }
+                endpoint.parts[timestampMs] = part
+            }
+        }
+    }
+
+    public func play(segmentTimestampMs: Int64, hostTime: Double, offsetMs: Int) {
+        let play = BroadcastPlayhead.Play(timestampMs: segmentTimestampMs, hostTime: hostTime, offsetMs: offsetMs)
+        self.playhead.add(play)
+        let playing = self.playhead.active(at: CACurrentMediaTime())
+        for endpoint in self.endpoints.values {
+            if let playing, endpoint.lastDeliveredMs < playing.timestampMs {
+                self.retire(endpoint)
+                continue
+            }
+            endpoint.queue.async {
+                endpoint.playhead.add(play)
+            }
+        }
+    }
+
+    private func retire(_ endpoint: Endpoint) {
+        self.endpoints.removeValue(forKey: endpoint.id)
+        endpoint.queue.async {
+            endpoint.timer?.cancel()
+            endpoint.timer = nil
+            for part in endpoint.parts.values {
+                BroadcastVideoPartRelease(part)
+            }
+            endpoint.parts.removeAll()
+            BroadcastVideoDecoderRelease(endpoint.decoder)
+        }
+    }
+
+    public func stop() {
+        for endpoint in self.endpoints.values {
+            endpoint.queue.sync {
+                endpoint.timer?.cancel()
+                endpoint.timer = nil
+                for part in endpoint.parts.values {
+                    BroadcastVideoPartRelease(part)
+                }
+                endpoint.parts.removeAll()
+                endpoint.playhead = BroadcastPlayhead()
+            }
+            BroadcastVideoDecoderRelease(endpoint.decoder)
+        }
+        self.endpoints.removeAll()
+        self.playhead = BroadcastPlayhead()
+    }
+
+    private func pipe(_ endpointId: String) -> ValuePipe<OngoingGroupCallContext.VideoFrameData> {
+        return self.pipes.modify { pipes in
+            var pipes = pipes
+            if pipes[endpointId] == nil {
+                pipes[endpointId] = ValuePipe()
+            }
+            return pipes
+        }[endpointId]!
+    }
+
+    private func endpoint(_ id: String) -> Endpoint {
+        if let endpoint = self.endpoints[id] {
+            return endpoint
+        }
+        let endpoint = Endpoint(id: id, playhead: self.playhead, frames: self.pipe(id))
+        self.endpoints[id] = endpoint
+        let timer = DispatchSource.makeTimerSource(queue: endpoint.queue)
+        timer.schedule(deadline: .now(), repeating: .milliseconds(16), leeway: .milliseconds(1))
+        timer.setEventHandler { [weak endpoint] in
+            guard let endpoint else {
+                return
+            }
+            GroupCallBroadcastVideoOutput.show(endpoint)
+        }
+        endpoint.timer = timer
+        timer.resume()
+        return endpoint
+    }
+
+    private static func show(_ endpoint: Endpoint) {
+        let now = CACurrentMediaTime()
+        guard let playing = endpoint.playhead.active(at: now) else {
+            return
+        }
+        for (timestampMs, part) in endpoint.parts where timestampMs < playing.timestampMs {
+            BroadcastVideoPartRelease(part)
+            endpoint.parts.removeValue(forKey: timestampMs)
+        }
+        guard let part = endpoint.parts[playing.timestampMs] else {
