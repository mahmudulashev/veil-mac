--- /dev/null
+++ b/submodules/TelegramCore/Sources/Ghost/GhostReadOnReply.swift
@@ -0,0 +1,35 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+internal import TelegramApi
+
+func ghostMarkPeerReadOnReply(account: Account, peerId: PeerId) {
+    guard GhostMode.flags.readOnReply, peerId.namespace != Namespaces.Peer.SecretChat else {
+        return
+    }
+    let network = account.network
+    let _ = (account.postbox.transaction { transaction -> (Api.InputPeer?, Int32?) in
+        let inputPeer = transaction.getPeer(peerId).flatMap(apiInputPeer)
+        let topId = transaction.getTopPeerMessageId(peerId: peerId, namespace: Namespaces.Message.Cloud)?.id
+        return (inputPeer, topId)
+    }
+    |> mapToSignal { inputPeer, topId -> Signal<Never, NoError> in
+        guard let inputPeer = inputPeer, let topId = topId, topId > 0 else {
+            return .complete()
+        }
+        switch inputPeer {
+        case let .inputPeerChannel(data):
+            return network.request(Api.functions.channels.readHistory(channel: Api.InputChannel.inputChannel(.init(channelId: data.channelId, accessHash: data.accessHash)), maxId: topId))
+            |> `catch` { _ -> Signal<Api.Bool, NoError> in
+                return .complete()
+            }
+            |> ignoreValues
+        default:
+            return network.request(Api.functions.messages.readHistory(peer: inputPeer, maxId: topId))
+            |> `catch` { _ -> Signal<Api.messages.AffectedMessages, NoError> in
+                return .complete()
+            }
+            |> ignoreValues
+        }
+    }).start()
+}
