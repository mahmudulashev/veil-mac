+import Foundation
+
+public final class GhostMode {
+    public struct Settings: Codable, Equatable {
+        public var enabled: Bool
+        public var hideReadReceipts: Bool
+        public var hideOnline: Bool
+        public var hideTyping: Bool
+        public var hideStoryViews: Bool
+        public var hideOpenedContent: Bool
+        public var keepDeletedMessages: Bool
+        public var keepEditHistory: Bool
+        public var readOnReply: Bool
+
+        public init(enabled: Bool = false, hideReadReceipts: Bool = true, hideOnline: Bool = true, hideTyping: Bool = true, hideStoryViews: Bool = true, hideOpenedContent: Bool = true, keepDeletedMessages: Bool = true, keepEditHistory: Bool = true, readOnReply: Bool = true) {
+            self.enabled = enabled
+            self.hideReadReceipts = hideReadReceipts
+            self.hideOnline = hideOnline
+            self.hideTyping = hideTyping
+            self.hideStoryViews = hideStoryViews
+            self.hideOpenedContent = hideOpenedContent
+            self.keepDeletedMessages = keepDeletedMessages
+            self.keepEditHistory = keepEditHistory
+            self.readOnReply = readOnReply
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            let defaults = Settings()
+            self.enabled = try container.decodeIfPresent(Bool.self, forKey: .enabled) ?? defaults.enabled
+            self.hideReadReceipts = try container.decodeIfPresent(Bool.self, forKey: .hideReadReceipts) ?? defaults.hideReadReceipts
+            self.hideOnline = try container.decodeIfPresent(Bool.self, forKey: .hideOnline) ?? defaults.hideOnline
+            self.hideTyping = try container.decodeIfPresent(Bool.self, forKey: .hideTyping) ?? defaults.hideTyping
+            self.hideStoryViews = try container.decodeIfPresent(Bool.self, forKey: .hideStoryViews) ?? defaults.hideStoryViews
+            self.hideOpenedContent = try container.decodeIfPresent(Bool.self, forKey: .hideOpenedContent) ?? defaults.hideOpenedContent
+            self.keepDeletedMessages = try container.decodeIfPresent(Bool.self, forKey: .keepDeletedMessages) ?? defaults.keepDeletedMessages
+            self.keepEditHistory = try container.decodeIfPresent(Bool.self, forKey: .keepEditHistory) ?? defaults.keepEditHistory
+            self.readOnReply = try container.decodeIfPresent(Bool.self, forKey: .readOnReply) ?? defaults.readOnReply
+        }
+    }
+
+    public struct Flags: Equatable {
+        public let hideReadReceipts: Bool
+        public let hideOnline: Bool
+        public let hideTyping: Bool
+        public let hideStoryViews: Bool
+        public let hideOpenedContent: Bool
+        public let readOnReply: Bool
+
+        init(_ settings: Settings) {
+            self.hideReadReceipts = settings.enabled && settings.hideReadReceipts
+            self.hideOnline = settings.enabled && settings.hideOnline
+            self.hideTyping = settings.enabled && settings.hideTyping
+            self.hideStoryViews = settings.enabled && settings.hideStoryViews
+            self.hideOpenedContent = settings.enabled && settings.hideOpenedContent
+            self.readOnReply = settings.enabled && settings.hideReadReceipts && settings.readOnReply
+        }
+    }
+
+    private static let defaultsKey = "veil.ghostMode"
+    private static let lock = NSLock()
+    private static var storedSettings: Settings = {
+        if let data = UserDefaults.standard.data(forKey: defaultsKey), let value = try? JSONDecoder().decode(Settings.self, from: data) {
+            return value
+        }
+        return Settings()
+    }()
+    private static var listeners: [Int: (Settings) -> Void] = [:]
+    private static var nextListenerId = 0
+
+    public static var settings: Settings {
+        get {
+            lock.lock()
+            defer { lock.unlock() }
+            return storedSettings
+        }
+        set {
+            lock.lock()
+            let changed = storedSettings != newValue
+            storedSettings = newValue
+            let currentListeners = Array(listeners.values)
+            lock.unlock()
+            guard changed else {
+                return
+            }
+            if let data = try? JSONEncoder().encode(newValue) {
+                UserDefaults.standard.set(data, forKey: defaultsKey)
+            }
+            for listener in currentListeners {
+                listener(newValue)
+            }
+        }
+    }
+
+    public static var flags: Flags {
+        return Flags(settings)
+    }
+
+    public static func update(_ f: (inout Settings) -> Void) {
+        var value = settings
+        f(&value)
+        settings = value
+    }
+
+    @discardableResult
+    public static func addListener(_ f: @escaping (Settings) -> Void) -> Int {
+        lock.lock()
+        let id = nextListenerId
+        nextListenerId += 1
+        listeners[id] = f
+        lock.unlock()
+        return id
+    }
+
+    public static func removeListener(_ id: Int) {
+        lock.lock()
+        listeners[id] = nil
+        lock.unlock()
+    }
+}
+
+public enum VeilPrivacy {
+    public static let blocksTelemetry = true
+}
