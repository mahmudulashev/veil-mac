diff --git a/submodules/TelegramCore/Sources/Ghost/GhostMessageArchive.swift b/submodules/TelegramCore/Sources/Ghost/GhostMessageArchive.swift
new file mode 100644
index 00000000..ecfc3c6e
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Ghost/GhostMessageArchive.swift
@@ -0,0 +1,140 @@
+import Foundation
+import Postbox
+
+public final class VeilDeletedMessageAttribute: MessageAttribute {
+    public let date: Int32
+
+    public init(date: Int32) {
+        self.date = date
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        self.date = decoder.decodeInt32ForKey("d", orElse: 0)
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt32(self.date, forKey: "d")
+    }
+}
+
+public final class VeilEditHistoryAttribute: MessageAttribute {
+    public struct Entry: Equatable {
+        public let text: String
+        public let date: Int32
+    }
+
+    public static let maxEntries = 20
+
+    public let entries: [Entry]
+
+    public init(entries: [Entry]) {
+        self.entries = entries
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        let texts = decoder.decodeStringArrayForKey("t")
+        let dates = decoder.decodeInt32ArrayForKey("d")
+        var entries: [Entry] = []
+        for i in 0 ..< min(texts.count, dates.count) {
+            entries.append(Entry(text: texts[i], date: dates[i]))
+        }
+        self.entries = entries
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeStringArray(self.entries.map { $0.text }, forKey: "t")
+        encoder.encodeInt32Array(self.entries.map { $0.date }, forKey: "d")
+    }
+}
+
+public extension Message {
+    var veilDeletedDate: Int32? {
+        for attribute in self.attributes {
+            if let attribute = attribute as? VeilDeletedMessageAttribute {
+                return attribute.date
+            }
+        }
+        return nil
+    }
+
+    var veilEditHistory: [VeilEditHistoryAttribute.Entry] {
+        for attribute in self.attributes {
+            if let attribute = attribute as? VeilEditHistoryAttribute {
+                return attribute.entries
+            }
+        }
+        return []
+    }
+}
+
+func ghostMergeArchivedAttributes(previous: [MessageAttribute], updated: inout [MessageAttribute]) {
+    if !updated.contains(where: { $0 is VeilDeletedMessageAttribute }), let attribute = previous.first(where: { $0 is VeilDeletedMessageAttribute }) {
+        updated.append(attribute)
+    }
+    if !updated.contains(where: { $0 is VeilEditHistoryAttribute }), let attribute = previous.first(where: { $0 is VeilEditHistoryAttribute }) {
+        updated.append(attribute)
+    }
+}
+
+private func ghostMarkMessageDeleted(transaction: Transaction, id: MessageId, date: Int32) {
+    transaction.updateMessage(id, update: { current in
+        var storeForwardInfo: StoreMessageForwardInfo?
+        if let forwardInfo = current.forwardInfo {
+            storeForwardInfo = StoreMessageForwardInfo(authorId: forwardInfo.author?.id, sourceId: forwardInfo.source?.id, sourceMessageId: forwardInfo.sourceMessageId, date: forwardInfo.date, authorSignature: forwardInfo.authorSignature, psaType: forwardInfo.psaType, flags: forwardInfo.flags)
+        }
+        var attributes = current.attributes
+        attributes.append(VeilDeletedMessageAttribute(date: date))
+        return .update(StoreMessage(id: current.id, customStableId: nil, globallyUniqueId: current.globallyUniqueId, groupingKey: current.groupingKey, threadId: current.threadId, timestamp: current.timestamp, flags: StoreMessageFlags(current.flags), tags: current.tags, globalTags: current.globalTags, localTags: current.localTags, forwardInfo: storeForwardInfo, authorId: current.author?.id, text: current.text, attributes: attributes, media: current.media))
+    })
+}
+
+private func ghostShouldPreserve(transaction: Transaction, id: MessageId, keep: Bool, date: Int32) -> Bool {
+    guard let message = transaction.getMessage(id) else {
+        return false
+    }
+    if message.veilDeletedDate != nil {
+        return true
+    }
+    guard keep, id.namespace == Namespaces.Message.Cloud else {
+        return false
+    }
+    ghostMarkMessageDeleted(transaction: transaction, id: id, date: date)
+    return true
+}
+
+func ghostMessageIdsToDelete(transaction: Transaction, ids: [MessageId]) -> [MessageId] {
+    if ids.isEmpty {
+        return ids
+    }
+    let keep = GhostMode.settings.keepDeletedMessages
+    let date = Int32(Date().timeIntervalSince1970)
+    return ids.filter { !ghostShouldPreserve(transaction: transaction, id: $0, keep: keep, date: date) }
+}
+
+func ghostGlobalIdsToDelete(transaction: Transaction, globalIds: [Int32]) -> [Int32] {
+    if globalIds.isEmpty {
+        return globalIds
+    }
+    let keep = GhostMode.settings.keepDeletedMessages
+    let date = Int32(Date().timeIntervalSince1970)
+    return globalIds.filter { globalId in
+        guard let id = transaction.messageIdsForGlobalIds([globalId]).first else {
+            return true
+        }
+        return !ghostShouldPreserve(transaction: transaction, id: id, keep: keep, date: date)
+    }
+}
+
+func ghostRecordingEditHistory(previous: Message, updated: StoreMessage) -> StoreMessage {
+    guard GhostMode.settings.keepEditHistory, previous.text != updated.text, !previous.text.isEmpty else {
+        return updated
+    }
+    var entries = previous.veilEditHistory
+    entries.append(VeilEditHistoryAttribute.Entry(text: previous.text, date: previous.editedTime ?? previous.timestamp))
+    if entries.count > VeilEditHistoryAttribute.maxEntries {
+        entries.removeFirst(entries.count - VeilEditHistoryAttribute.maxEntries)
+    }
+    var attributes = updated.attributes.filter { !($0 is VeilEditHistoryAttribute) }
+    attributes.append(VeilEditHistoryAttribute(entries: entries))
+    return updated.withUpdatedAttributes(attributes)
+}
